NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Server-only. Required for Google Calendar read-only connection/token storage.
SUPABASE_SERVICE_ROLE_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional. If omitted, AI Plan Review uses deterministic rule-based suggestions.
OPENAI_API_KEY=
OPENAI_ASSISTANT_MODEL=gpt-4o-mini
# Optional legacy fallback for OPENAI_ASSISTANT_MODEL.
AI_MODEL=
# Optional comparison model used only by npm run eval:assistant-models.
OPENAI_ASSISTANT_EVAL_MODEL=
